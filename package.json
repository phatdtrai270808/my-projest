{
  "name": "coffee-pos-project",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix DUANCF run dev",
    "dev:backend": "npm --prefix server run dev",
    "db:push": "npx --prefix server prisma db push --schema=server/prisma/schema.prisma",
    "db:seed": "node server/prisma/seed.js",
    "db:upload-images": "node server/scripts/upload_product_images.js",
    "db:studio": "npx --prefix server prisma studio --schema=server/prisma/schema.prisma"
  },
  "dependencies": {
    "lucide-react": "^1.63.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
